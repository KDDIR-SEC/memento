diff --git a/arch/x86/kvm/rndlog.c b/arch/x86/kvm/rndlog.c
new file mode 100644
index 0000000000000000000000000000000000000000..a434f2e66a4ac2ef775c33164be3cd8c2373203b
--- /dev/null
+++ b/arch/x86/kvm/rndlog.c
@@ -0,0 +1,265 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * KVM RDRAND/RDSEED logging module - ring buffer + debugfs (Phase 5/6)
+ *
+ * Called from the VM-exit handler (atomic context) through rndlog_record();
+ * stores fixed-length binary records in an in-kernel ring buffer.
+ * When the buffer is full, drop mode discards the record and increments
+ * drop_count.
+ *
+ * Phase 6: exposes the following under /sys/kernel/debug/kvm_rndlog/.
+ *   enabled    (rw) recording on/off (default true; the emulation itself always runs)
+ *   buffer     (ro) consumes the ring buffer FIFO, one struct rndlog_record at a time
+ *   stats      (ro) total(seq) / drop_count / used as text
+ *   drop_count (ro) number of discarded records
+ *
+ * This file is linked into kvm-intel.ko (arch/x86/kvm/Makefile).
+ *
+ * Stores fixed-length records in a debugfs ring and exposes drop statistics.
+ */
+
+#include <linux/types.h>
+#include <linux/build_bug.h>
+#include <linux/spinlock.h>
+#include <linux/atomic.h>
+#include <linux/string.h>
+#include <linux/debugfs.h>
+#include <linux/uaccess.h>
+#include <linux/fs.h>
+#include <linux/module.h>
+#include <asm/tsc.h>		/* tsc_khz (cycles -> ns for handler timing) */
+
+#include "rndlog.h"
+
+/*
+ * Number of records in the ring buffer (a power of 2).
+ * sizeof(struct rndlog_record) is about 104 B, so 65536 records take about 6.8 MiB.
+ */
+#define RNDLOG_NR_RECORDS	65536U
+#define RNDLOG_MASK		(RNDLOG_NR_RECORDS - 1U)
+
+static struct rndlog_record rndlog_buf[RNDLOG_NR_RECORDS];
+static DEFINE_SPINLOCK(rndlog_lock);
+static unsigned int rndlog_head;	/* next position to write */
+static unsigned int rndlog_tail;	/* next position to read (consumed through debugfs buffer) */
+static unsigned int rndlog_count;	/* number of unread records */
+static u64 rndlog_drop_count;		/* records discarded because the buffer was full */
+static atomic64_t rndlog_seq = ATOMIC64_INIT(0);
+static bool rndlog_enabled = true;	/* recording on/off (debugfs enabled) */
+
+/*
+ * Counters for the performance breakdown: accumulate the VM-exit handler's
+ * software processing time (ii). Atomic adds only, no lock (adds no contention
+ * to the recording hot path).
+ */
+static atomic64_t rndlog_handler_cycles = ATOMIC64_INIT(0);
+static atomic64_t rndlog_handler_calls  = ATOMIC64_INIT(0);
+
+/*
+ * Diagnostics: total records delivered to rndlogd through buffer (debugfs).
+ * If total_records (enqueued) == consumed == host JSONL lines and
+ * drop_count == 0, then "drop_count=0 implies 100% capture" holds.
+ * consumed < total_records shows a loss on the kernel side (behaviour when over
+ * capacity); host < consumed shows a loss in rndlogd.
+ */
+static atomic64_t rndlog_consumed = ATOMIC64_INIT(0);
+
+static struct dentry *rndlog_dir;
+
+#ifdef MEMENTO_KVM_VALIDATION_FAULTS
+static unsigned int rndlog_fail_init_after;
+module_param_named(rndlog_fail_init_after, rndlog_fail_init_after, uint, 0400);
+MODULE_PARM_DESC(rndlog_fail_init_after,
+		 "validation only: fail after debugfs initialization step N");
+#endif
+
+static bool rndlog_fault_requested(unsigned int step)
+{
+#ifdef MEMENTO_KVM_VALIDATION_FAULTS
+	return rndlog_fail_init_after == step;
+#else
+	(void)step;
+	return false;
+#endif
+}
+
+void rndlog_record(struct rndlog_record *rec)
+{
+	unsigned long flags;
+
+	if (!READ_ONCE(rndlog_enabled))
+		return;
+
+	/* Fill the common fields here (so no caller can miss them) */
+	rec->magic = RNDLOG_MAGIC;
+	rec->version = RNDLOG_VERSION;
+	rec->record_size = sizeof(*rec);
+	rec->seq = (u64)atomic64_inc_return(&rndlog_seq);
+
+	spin_lock_irqsave(&rndlog_lock, flags);
+	if (rndlog_count >= RNDLOG_NR_RECORDS) {
+		/* drop mode: when full, discard the record and let the guest keep running */
+		rndlog_drop_count++;
+	} else {
+		rndlog_buf[rndlog_head] = *rec;
+		rndlog_head = (rndlog_head + 1) & RNDLOG_MASK;
+		rndlog_count++;
+	}
+	spin_unlock_irqrestore(&rndlog_lock, flags);
+}
+
+void rndlog_account_handler(u64 cycles)
+{
+	atomic64_add((s64)cycles, &rndlog_handler_cycles);
+	atomic64_inc(&rndlog_handler_calls);
+}
+
+/* Take one record from the ring buffer. True if one was taken. */
+static bool rndlog_dequeue(struct rndlog_record *out)
+{
+	unsigned long flags;
+	bool got = false;
+
+	spin_lock_irqsave(&rndlog_lock, flags);
+	if (rndlog_count > 0) {
+		*out = rndlog_buf[rndlog_tail];
+		rndlog_tail = (rndlog_tail + 1) & RNDLOG_MASK;
+		rndlog_count--;
+		got = true;
+	}
+	spin_unlock_irqrestore(&rndlog_lock, flags);
+	return got;
+}
+
+/*
+ * buffer: FIFO read, one record at a time.
+ * copy_to_user is called outside the spinlock (dequeue copies to the stack first).
+ * Returns 0 when empty (user space waits by polling).
+ */
+static ssize_t rndlog_buffer_read(struct file *file, char __user *ubuf,
+				  size_t count, loff_t *ppos)
+{
+	struct rndlog_record rec;
+	size_t done = 0;
+
+	while (count - done >= sizeof(rec)) {
+		if (!rndlog_dequeue(&rec))
+			break;
+		if (copy_to_user(ubuf + done, &rec, sizeof(rec)))
+			return done ? (ssize_t)done : -EFAULT;
+		done += sizeof(rec);
+		atomic64_inc(&rndlog_consumed);
+	}
+	return done;
+}
+
+static const struct file_operations rndlog_buffer_fops = {
+	.owner = THIS_MODULE,
+	.read  = rndlog_buffer_read,
+	.llseek = noop_llseek,
+};
+
+/* stats: return the statistics as text */
+static ssize_t rndlog_stats_read(struct file *file, char __user *ubuf,
+				 size_t count, loff_t *ppos)
+{
+	char buf[384];
+	unsigned int used;
+	unsigned long flags;
+	u64 hcalls, hcycles, avg_cyc, avg_ns;
+	int len;
+
+	spin_lock_irqsave(&rndlog_lock, flags);
+	used = rndlog_count;
+	spin_unlock_irqrestore(&rndlog_lock, flags);
+
+	/* Performance breakdown: mean cycles/ns of in-handler processing (ii),
+	 * with the raw values for manual checks */
+	hcalls  = (u64)atomic64_read(&rndlog_handler_calls);
+	hcycles = (u64)atomic64_read(&rndlog_handler_cycles);
+	avg_cyc = hcalls ? hcycles / hcalls : 0;
+	avg_ns  = (tsc_khz && hcalls) ? avg_cyc * 1000000ULL / tsc_khz : 0;
+
+	len = scnprintf(buf, sizeof(buf),
+			"total_records: %llu\nconsumed: %llu\ndrop_count: %llu\nbuffer_used: %u\nbuffer_capacity: %u\nenabled: %d\n"
+			"handler_calls: %llu\nhandler_cycles_total: %llu\nhandler_cycles_avg: %llu\ntsc_khz: %u\nhandler_ns_avg: %llu\n",
+			(u64)atomic64_read(&rndlog_seq),
+			(u64)atomic64_read(&rndlog_consumed),
+			(u64)READ_ONCE(rndlog_drop_count),
+			used, RNDLOG_NR_RECORDS, rndlog_enabled ? 1 : 0,
+			hcalls, hcycles, avg_cyc, tsc_khz, avg_ns);
+
+	return simple_read_from_buffer(ubuf, count, ppos, buf, len);
+}
+
+static const struct file_operations rndlog_stats_fops = {
+	.owner = THIS_MODULE,
+	.read  = rndlog_stats_read,
+	.llseek = default_llseek,
+};
+
+int rndlog_init(void)
+{
+	struct dentry *entry;
+	int err;
+
+	BUILD_BUG_ON(sizeof(struct rndlog_record) != 104);
+	BUILD_BUG_ON(offsetof(struct rndlog_record, inst) != 64);
+	BUILD_BUG_ON(offsetof(struct rndlog_record, operand_bits) != 65);
+	BUILD_BUG_ON(offsetof(struct rndlog_record, insn_len) != 68);
+	BUILD_BUG_ON(offsetof(struct rndlog_record, insn_bytes) != 72);
+	BUILD_BUG_ON(offsetof(struct rndlog_record, value) != 88);
+	BUILD_BUG_ON(offsetof(struct rndlog_record, cpu) != 96);
+	BUILD_BUG_ON(offsetof(struct rndlog_record, reserved) != 100);
+	rndlog_dir = debugfs_create_dir("kvm_rndlog", NULL);
+	if (IS_ERR(rndlog_dir)) {
+		err = PTR_ERR(rndlog_dir);
+		rndlog_dir = NULL;
+		return err;
+	}
+	if (rndlog_fault_requested(1)) {
+		entry = ERR_PTR(-EIO);
+		goto fail;
+	}
+
+	debugfs_create_bool("enabled", 0644, rndlog_dir, &rndlog_enabled);
+	if (rndlog_fault_requested(2)) {
+		entry = ERR_PTR(-EIO);
+		goto fail;
+	}
+	entry = debugfs_create_file("buffer", 0400, rndlog_dir, NULL,
+				    &rndlog_buffer_fops);
+	if (IS_ERR(entry))
+		goto fail;
+	if (rndlog_fault_requested(3)) {
+		entry = ERR_PTR(-EIO);
+		goto fail;
+	}
+	entry = debugfs_create_file("stats", 0400, rndlog_dir, NULL,
+				    &rndlog_stats_fops);
+	if (IS_ERR(entry))
+		goto fail;
+	if (rndlog_fault_requested(4)) {
+		entry = ERR_PTR(-EIO);
+		goto fail;
+	}
+	debugfs_create_u64("drop_count", 0400, rndlog_dir,
+			   &rndlog_drop_count);
+	if (rndlog_fault_requested(5)) {
+		entry = ERR_PTR(-EIO);
+		goto fail;
+	}
+	return 0;
+
+fail:
+	err = PTR_ERR(entry);
+	debugfs_remove_recursive(rndlog_dir);
+	rndlog_dir = NULL;
+	return err;
+}
+
+void rndlog_exit(void)
+{
+	debugfs_remove_recursive(rndlog_dir);
+	rndlog_dir = NULL;
+}
diff --git a/arch/x86/kvm/rndlog.h b/arch/x86/kvm/rndlog.h
new file mode 100644
index 0000000000000000000000000000000000000000..e69cffd9d7a5d62744d985b83334215628d7fb61
--- /dev/null
+++ b/arch/x86/kvm/rndlog.h
@@ -0,0 +1,108 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * KVM RDRAND/RDSEED logging module
+ *
+ * Internal API for recording, in a ring buffer, the values captured by
+ * VM exits when the guest executes RDRAND/RDSEED.
+ *
+ * Defines the record format shared by the KVM producer and the user-space consumer.
+ */
+
+#ifndef __KVM_RNDLOG_H
+#define __KVM_RNDLOG_H
+
+#include <linux/types.h>
+
+/* Magic value identifying a log record: "RNDL" */
+#define RNDLOG_MAGIC    0x524E444CU
+
+/* Log record version */
+#define RNDLOG_VERSION  1
+
+/**
+ * enum rndlog_inst - type of the captured instruction
+ */
+enum rndlog_inst {
+	RNDLOG_INST_RDRAND = 1,
+	RNDLOG_INST_RDSEED = 2,
+};
+
+/**
+ * struct rndlog_record - fixed-length binary record stored in the in-kernel ring buffer
+ *
+ * Written inside the VM-exit handler (atomic context), so every
+ * field is a basic type.
+ *
+ * The user-space rndlogd reads this structure through debugfs and stores it
+ * as JSONL, converted using value and operand_bits.
+ */
+struct rndlog_record {
+	__u32 magic;			/* RNDLOG_MAGIC (0x524E444C) */
+	__u16 version;			/* RNDLOG_VERSION (1) */
+	__u16 record_size;		/* sizeof(struct rndlog_record) */
+
+	__u64 seq;			/* monotonically increasing sequence number */
+	__u64 ktime_ns;			/* record time from ktime_get_ns() (ns) */
+
+	__u32 vm_id;			/* VM identifier (pointer value of vcpu->kvm) */
+	__u32 vcpu_id;			/* vCPU ID (vcpu->vcpu_id) */
+
+	__u64 guest_rip;		/* guest RIP at the VM exit */
+	__u64 guest_cr3;		/* guest CR3 at the VM exit (identifies the process) */
+	__u64 guest_rflags_before;	/* RFLAGS before the instruction */
+	__u64 guest_rflags_after;	/* RFLAGS after the instruction (CF=1 set) */
+
+	__u8  inst;			/* enum rndlog_inst: RDRAND=1, RDSEED=2 */
+	__u8  operand_bits;		/* operand width: 16, 32 or 64 */
+	__u8  dest_reg;			/* destination register index (0=RAX ... 15=R15) */
+	__u8  success;			/* 1 = success (CF=1), 0 = failure (CF=0) */
+
+	__u32 insn_len;			/* instruction length (from VM_EXIT_INSTRUCTION_LEN) */
+	__u8  insn_bytes[16];		/* instruction bytes (for debugging and validation) */
+
+	__u64 value;			/* value returned to the guest (masked to operand_bits) */
+
+	__u32 cpu;			/* smp_processor_id() (host physical CPU number) */
+	__u32 reserved;			/* padding (for future use, initialized to 0) */
+};
+
+/**
+ * rndlog_record() - add a log record to the ring buffer
+ * @rec: record to write (the caller must have set every field)
+ *
+ * Called from the VM-exit handler (atomic context).
+ * When the buffer is full, drop mode discards the record and increments drop_count.
+ *
+ * Implementation: arch/x86/kvm/rndlog.c (added in Phase 5)
+ */
+void rndlog_record(struct rndlog_record *rec);
+
+/**
+ * rndlog_account_handler() - accumulate the VM-exit handler's processing cycles
+ * @cycles: TSC cycles from handler entry to just before return (rdtsc() delta)
+ *
+ * For measuring the performance breakdown (cost inherent to the method vs cost from nesting).
+ * Accumulates the in-handler software processing time (ii); debugfs stats exposes the mean.
+ * Called from the VM-exit handler (atomic context).
+ *
+ * Implementation: arch/x86/kvm/rndlog.c
+ */
+void rndlog_account_handler(__u64 cycles);
+
+/**
+ * rndlog_init() - initialize the ring buffer and the debugfs entries
+ *
+ * Called when the kvm_intel module is initialized.
+ * Implementation: arch/x86/kvm/rndlog.c (added in Phase 5)
+ */
+int rndlog_init(void);
+
+/**
+ * rndlog_exit() - release the ring buffer and the debugfs entries
+ *
+ * Called when the kvm_intel module exits.
+ * Implementation: arch/x86/kvm/rndlog.c (added in Phase 5)
+ */
+void rndlog_exit(void);
+
+#endif /* __KVM_RNDLOG_H */
