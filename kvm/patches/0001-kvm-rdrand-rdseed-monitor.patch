+/*
+ * kvm_rndlog: Phase 5 - RDRAND/RDSEED real random generation + ring buffer recording
+ *
+ * Decodes the RDRAND/RDSEED instruction (0F C7 /6, /7) to find the destination
+ * register and operand width, writes back a value generated with
+ * get_random_bytes(), and sets CF=1. The generated value and the instruction
+ * metadata are collected in a struct rndlog_record and recorded in the
+ * in-kernel ring buffer with rndlog_record() (debugfs exposure is Phase 6).
+ *
+ * emulate.c does not implement RDRAND/RDSEED, so this is not delegated to the
+ * generic emulator. On a decode failure, CF=0 is returned and the instruction
+ * is skipped, protecting the guest.
+ *
+ * With the module parameter rndlog_deterministic=1, fixed values are returned
+ * (reproducibility tests and Phase 4 regression).
+ */
+#define RNDLOG_FIXED_RDRAND	0x1122334455667788ULL
+#define RNDLOG_FIXED_RDSEED	0x8877665544332211ULL
+
+static bool rndlog_deterministic;
+module_param_named(rndlog_deterministic, rndlog_deterministic, bool, 0644);
+MODULE_PARM_DESC(rndlog_deterministic,
+		 "kvm_rndlog: return fixed values instead of get_random_bytes() (reproducibility tests)");
+
+static int handle_rndlog(struct kvm_vcpu *vcpu, bool is_rdseed)
+{
+	const char *name = is_rdseed ? "RDSEED" : "RDRAND";
+	u64 t0 = rdtsc();	/* kvm_rndlog: measure handler time (ii) */
+	u64 fixed = is_rdseed ? RNDLOG_FIXED_RDSEED : RNDLOG_FIXED_RDRAND;
+	u32 insn_len = vmcs_read32(VM_EXIT_INSTRUCTION_LEN);
+	unsigned long rip = kvm_rip_read(vcpu);
+	unsigned long rflags_before = vmx_get_rflags(vcpu);
+	struct x86_exception e;
+	struct rndlog_record rec;
+	unsigned long rflags;
+	u64 rnd;
+	u8 insn[16];
+	u8 modrm;
+	int i = 0, reg, bits;
+	bool rex_w = false, rex_b = false, opsize = false;
+
+	if (insn_len == 0 || insn_len > sizeof(insn))
+		goto fail;
+	if (kvm_read_guest_virt(vcpu, kvm_get_linear_rip(vcpu),
+				insn, insn_len, &e))
+		goto fail;
+
+	/* Scan legacy prefixes and REX */
+	while (i < insn_len) {
+		u8 b = insn[i];
+
+		if (b == 0x66) {		/* operand-size override */
+			opsize = true;
+			i++;
+			continue;
+		}
+		if (b == 0x67 || b == 0xF0 || b == 0xF2 || b == 0xF3 ||
+		    b == 0x2E || b == 0x36 || b == 0x3E || b == 0x26 ||
+		    b == 0x64 || b == 0x65) {	/* other prefixes */
+			i++;
+			continue;
+		}
+		if ((b & 0xF0) == 0x40) {	/* REX prefix */
+			rex_w = b & 0x08;
+			rex_b = b & 0x01;
+			i++;
+			continue;
+		}
+		break;
+	}
+
+	/* opcode 0F C7; the following ModRM selects the destination */
+	if (i + 2 >= insn_len || insn[i] != 0x0F || insn[i + 1] != 0xC7)
+		goto fail;
+
+	modrm = insn[i + 2];
+	reg = (modrm & 0x07) | (rex_b ? 0x08 : 0x00);
+	bits = rex_w ? 64 : (opsize ? 16 : 32);
+	if ((modrm & 0xC0) != 0xC0 || ((modrm >> 3) & 0x07) != (is_rdseed ? 7 : 6))
+		goto fail;
+
+	/* Value: real random by default, fixed with rndlog_deterministic; masked to the width */
+	if (rndlog_deterministic)
+		rnd = fixed;
+	else
+		get_random_bytes(&rnd, sizeof(rnd));
+	if (bits == 16)
+		rnd &= 0xFFFFULL;
+	else if (bits == 32)
+		rnd &= 0xFFFFFFFFULL;
+
+	/* Write back by operand width */
+	if (bits == 16) {
+		/* update only the low 16 bits and keep the upper bits */
+		u64 cur = kvm_register_read_raw(vcpu, reg);
+
+		kvm_register_write_raw(vcpu, reg, (cur & ~0xFFFFULL) | rnd);
+	} else {
+		/* 32-bit zero-extends (rnd is already masked), 64-bit writes the whole register */
+		kvm_register_write_raw(vcpu, reg, rnd);
+	}
+
+	/* Success: CF=1, OF/SF/ZF/AF/PF=0 */
+	rflags = rflags_before;
+	rflags |= X86_EFLAGS_CF;
+	rflags &= ~(X86_EFLAGS_OF | X86_EFLAGS_SF | X86_EFLAGS_ZF |
+		    X86_EFLAGS_AF | X86_EFLAGS_PF);
+	vmx_set_rflags(vcpu, rflags);
+
+	/* Record in the ring buffer (rndlog_record sets magic/version/record_size/seq) */
+	memset(&rec, 0, sizeof(rec));
+	rec.ktime_ns = ktime_get_ns();
+	rec.vm_id = (u32)(uintptr_t)vcpu->kvm;
+	rec.vcpu_id = vcpu->vcpu_id;
